# ===== Kết quả build =====
# Không neo bằng dấu "/" ở đầu, để phủ mọi module: app/, engine/, ai/, net/
build/
.gradle/
.kotlin/
.cxx/
.externalNativeBuild/
/captures

# ===== Cấu hình máy cá nhân (KHÔNG được commit) =====
# local.properties chứa đường dẫn Android SDK riêng của từng máy.
local.properties
*.iml
# keystore.properties chứa mật khẩu keystore. Commit nhầm một lần là phải tạo key mới,
# mà đổi key thì không cập nhật được app đã phát hành bằng key cũ.
keystore.properties

# ===== Sản phẩm đóng gói =====
*.apk
*.aab
*.aar
*.jar
!gradle/wrapper/gradle-wrapper.jar
*.keystore
*.jks

# ===== IDE =====
# Bỏ qua toàn bộ .idea: phần lớn là trạng thái cục bộ, sinh lại được khi mở project.
.idea/

