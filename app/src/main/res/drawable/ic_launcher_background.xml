<?xml version="1.0" encoding="utf-8"?>
<!-- Lớp nền của biểu tượng: bàn cờ hai màu.
     Chia đúng bốn ô lớn thay vì vẽ đủ 64 ô: ở cỡ biểu tượng thì 64 ô trông thành
     một mảng xám rối mắt. Phải phủ kín cả 108dp vì lớp nền còn bị launcher xê
     dịch nhẹ khi tạo hiệu ứng chiều sâu. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ô sẫm phủ toàn bộ khung -->
    <path
        android:fillColor="#6D4C41"
        android:pathData="M0,0h108v108h-108z" />

    <!-- Hai ô sáng ở hai góc đối diện, đủ để nhận ra là bàn cờ -->
    <path
        android:fillColor="#D7CCC8"
        android:pathData="M0,0h54v54h-54z" />
    <path
        android:fillColor="#D7CCC8"
        android:pathData="M54,54h54v54h-54z" />
</vector>
